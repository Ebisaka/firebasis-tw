    <最新異動日期>1130101</最新異動日期>
    <廢止註記>N</廢止註記>
    <條文>
      <條>
        <條號>第 1 條</條號>
        <條文內容>地方制度依本法之規定。</條文內容>
      </條>
    </條文>
  </法規>
